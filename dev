#!/bin/sh
set -eu

root=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
binary="$root/target/debug/maitri-mail"

build_backend() {
  cargo build --locked \
    --manifest-path "$root/Cargo.toml" \
    --target-dir "$root/target" \
    --bin maitri-mail
}

case "${1-}" in
  backend)
    build_backend
    printf 'Built %s\n' "$binary"
    ;;
  run)
    build_backend
    cat <<EOF
Built $binary

Development run prepared; the installed private runtime was not changed.
MAITRI_MAIL_BIN=$binary

The already-running shell cannot receive MAITRI_MAIL_BIN from a summon command.
Export that value in the environment used to start maitri-shell, then restart the existing maitri shell through your normal session method. After restart, open the plugin with:
  maitri-shell shell toggle maitri.mail '{}'
EOF
    ;;
  *)
    printf 'Usage: ./dev backend | run\n' >&2
    exit 2
    ;;
esac
